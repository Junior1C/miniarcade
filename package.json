{
  "name": "miniarcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Каталог браузерных HTML5-игр. Статика, без runtime-зависимостей.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "new": "node scripts/new-game.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "smoke": "node scripts/smoke.mjs",
    "og": "node scripts/gen-og.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
